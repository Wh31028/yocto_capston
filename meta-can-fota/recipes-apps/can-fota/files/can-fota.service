# ==============================================================================
# BeagleBone Black CAN-FOTA FastAPI 대시보드 웹 서버 데몬 서비스
# ==============================================================================
[Unit]
# 서비스 설명
Description=CAN-FOTA FastAPI Web Dashboard Service

# 네트워크 초기화 및 setup-can0.service(CAN 인터페이스 켜기)가 완료된 "후에" 실행하도록 순서 보장
After=network.target setup-can0.service

# setup-can0 서비스가 함께 켜지도록 연동 (setup-can0 실행 시도)
Wants=setup-can0.service

[Service]
# Type=simple: 백그라운드에서 지속적으로 대기하는 웹서버/데몬 프로세스에 사용
Type=simple

# root 권한으로 실행하여 python에서 CAN 소켓 제어 및 ip link 비트레이트 동적 변경이 가능하게 함
User=root

# uvicorn 실행 시 main:app 모듈과 templates/ static/ 경로를 정상 탐색할 수 있도록 BBB 내부 작업 경로 지정
WorkingDirectory=/usr/share/can-fota/web_dashboard

# uvicorn 웹 서버 실행 명령어 (외부에서 BBB IP로 접속 가능하도록 --host 0.0.0.0, 포트 8000 지정)
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port 8000

# 예외 종료되거나 예기치 않게 프로세스가 죽더라도 자동으로 무조건 재시작하도록 설정
Restart=always

# 비정상 종료 후 3초 대기 후 재시작 시도
RestartSec=3

[Install]
# 멀티유저 부팅 단계(멀티유저 타겟)에 이 서비스를 등록하여 부팅 시 자동 실행
WantedBy=multi-user.target
